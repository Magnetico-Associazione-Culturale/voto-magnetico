# Copia questo file in .env sul server e compila i valori. Il file .env NON va mai su GitHub.

# Dominio pubblico (deve puntare all'Elastic IP del server)
DOMAIN=voto.magnetico.cloud
PUBLIC_URL=https://voto.magnetico.cloud

# Server email per l'invio dei codici (es. la casella dell'associazione o un servizio SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# 1 = SSL diretto (porta 465), 0 = STARTTLS (porta 587)
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Votazioni Magnetico <voto@magnetico.cloud>"
